SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# LLM provider: gemini | openai | anthropic | ollama | openrouter
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.0
GOOGLE_API_KEY=your-google-api-key
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# To use Ollama instead, comment out the gemini block above and uncomment:
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# OLLAMA_BASE_URL=http://localhost:11434

# To use OpenRouter instead, comment out the gemini block above and uncomment:
# LLM_PROVIDER=openrouter
# LLM_MODEL=openai/gpt-4o-mini
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Retrieval
EMBEDDING_MODEL=all-MiniLM-L6-v2
DEFAULT_MATCH_COUNT=5
# Retrieval mode: vector (default) | bm25 | hybrid | graph | hybrid_graph
RETRIEVAL_MODE=vector
# RRF constant for hybrid mode (60 is the standard per the original paper)
# RRF_K=60

# App
CORS_ORIGINS=["*"]
LOG_LEVEL=INFO
